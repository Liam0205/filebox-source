#!/usr/bin/env bash
# filebox 的命令行客户端。
#
#   export FILEBOX_TOKEN=fb_xxxx        # 在 /admin 里生成
#   export FILEBOX_URL=https://…        # 从站点 /filebox 下载的脚本已带默认值
#   export FILEBOX_QUIET=1              # 可选，关掉 put/get 在终端里的进度条
#
#   filebox whoami                           # 检查 token 是否配置正确
#   filebox put ./photo.jpg                  # 上传到根目录，成功后打印下载地址
#   filebox put ./photo.jpg album/2026.jpg   # 上传到指定路径（同名默认拒绝）
#   filebox put -f ./photo.jpg album/2026.jpg  # 覆盖同名文件
#   filebox ls                               # 列出根目录下一层
#   filebox ls album                         # 列出 album 下一层
#   filebox ls -r [album]                    # 列出下面的全部文件
#   filebox get album/2026.jpg [保存为]
#   filebox url album/2026.jpg
#   filebox mkdir album/2026
#   filebox rm album/2026.jpg
#   filebox rmdir album/2026                 # 只删空目录
#   filebox keep album/2026.jpg              # 设为长期，不参与自动清理
#   filebox unkeep album/2026.jpg            # 取消长期
#   filebox update                           # 从站点下载新版，替换这个脚本
#   filebox version
#
# 单文件上限 2 GiB。超过 95 MiB 的文件会自动分段上传，下载时站点自动拼回一个文件。
#
# 这是临时存储：超过个人名额、或者全站文件太多时，最旧的非长期文件会被自动删除。
# 大文件每 95 MiB 左右占一个名额。ls 第一行显示用量。
#
# 依赖 bash、curl、od、sed，分段上传还要 dd、wc、mktemp；有 file 命令时用它判断文件类型。
#
# 兼容性要求：要能在 macOS 自带的 Bash 3.2、BSD 工具和旧版 curl 上跑。
# 所以不用关联数组、mapfile、${var,,}、curl 的 --fail-with-body，
# 也不依赖 python3 或 jq：需要解析的响应都让服务端用 ?format=text 返回纯文本。
# 变量后面紧跟中文（包括全角标点）时必须写成 ${name}：macOS 的 Bash 3.2 在 UTF-8 下
# 会把中文的首字节当成变量名的一部分。比如变量 new 后面直接跟「（」而不加花括号，会被
# 读成变量 new\xef，在 set -u 下直接报错。
set -euo pipefail

# Worker 下发脚本时会把这两行替换成站点地址和版本号；仓库里的副本保持原样。
DEFAULT_URL=""
VERSION="dev"
# 所有请求都带这个 UA，方便在访问统计里把命令行和浏览器、裸 curl 分开，也能看出
# 还有哪些旧版本在跑。UA 可以伪造，服务端只能拿它做统计，不能据此放行或区别对待。
UA="filebox-cli/$VERSION"

BASE="${FILEBOX_URL:-$DEFAULT_URL}"
if [ -z "$BASE" ]; then
  echo "需要设置 FILEBOX_URL，例如 https://filebox.example.com" >&2
  exit 1
fi
BASE="${BASE%/}"
TOKEN="${FILEBOX_TOKEN:-}"
NL='
'

# 传输较大的 put 和 get 在 stderr 连着终端时显示 curl 的进度条（-#），
# stderr 被重定向时保持安静。
QUIET=-s
PROGRESS=-s
if [ -t 2 ] && [ -z "${FILEBOX_QUIET:-}" ]; then PROGRESS=-#; fi

need_token() {
  if [ -z "$TOKEN" ]; then
    echo "需要设置 FILEBOX_TOKEN（在 $BASE/admin 里生成）" >&2
    exit 1
  fi
}

# 调接口。成功时把响应体写到 stdout；HTTP 状态不是 2xx 时把响应体写到 stderr，返回 1。
# 最近一次的 HTTP 状态码留在 API_CODE 里（网络错误时为空）。
API_CODE=""
api() {
  local out code
  need_token
  API_CODE=""
  if ! out=$(curl "$QUIET" -S --max-time 0 -A "$UA" -w "$NL%{http_code}" -H "Authorization: Bearer $TOKEN" "$@"); then
    return 1
  fi
  code=${out##*"$NL"}
  out=${out%"$NL"*}
  out=${out%"$NL"}
  API_CODE=$code
  case "$code" in
    2[0-9][0-9])
      printf '%s\n' "$out"
      ;;
    *)
      printf '%s\n' "$out" >&2
      return 1
      ;;
  esac
}

# 上传类请求遇到 507（release 满了，服务端已经清理了一批旧文件）时重传一次。
api_retry() {
  if api "$@"; then return 0; fi
  if [ "$API_CODE" != "507" ]; then return 1; fi
  echo "重新上传一次…" >&2
  api "$@"
}

# 百分号编码。每个字节都编码成 %xx，服务端照样能解开；
# 用 od 拿字节，避开 Bash 3.2 按 locale 切字符的问题。
q() {
  # shellcheck disable=SC2046
  printf '%%%s' $(printf '%s' "$1" | od -An -tx1 -v)
}

mime() {
  local t=""
  if command -v file >/dev/null 2>&1; then
    t=$(file --brief --mime-type "$1" 2>/dev/null || true)
  fi
  case "$t" in
    */*) printf '%s\n' "$t" ;;
    *) printf '%s\n' "application/octet-stream" ;;
  esac
}

need() {
  if [ -z "${1:-}" ]; then
    echo "用法: filebox $2" >&2
    exit 1
  fi
}

# 这个脚本在磁盘上的真实路径。从 PATH 里运行时 $0 是完整路径；
# 用 bash filebox 运行时 $0 是相对路径；中间如果有软链接，一层层解开。
# macOS 的 readlink 没有 -f，所以自己循环。
self_path() {
  local p="$0" link n=0
  case "$p" in
    */*) ;;
    *)
      if [ -f "$p" ]; then p="./$p"; else p=$(command -v "$p" 2>/dev/null || true); fi
      ;;
  esac
  if [ -z "$p" ] || [ ! -f "$p" ]; then return 1; fi
  while [ -h "$p" ] && [ "$n" -lt 40 ]; do
    link=$(readlink "$p")
    case "$link" in
      /*) p="$link" ;;
      *) p="${p%/*}/$link" ;;
    esac
    n=$((n + 1))
  done
  printf '%s/%s\n' "$(cd "${p%/*}" && pwd -P)" "${p##*/}"
}

# 分段上传：按服务端给的段长用 dd 切出临时文件，逐段上传换回执，最后交回全部回执。
# 一段失败就整个放弃：已经传上去的段没有索引，过几个小时会被自动清掉。
put_parts() {
  local src="$1" dest="$2" size="$3" part_bytes="$4" type="$5" overwrite="$6"
  local of mib id part n receipt receipts="" qd
  of=$(( (size + part_bytes - 1) / part_bytes ))
  mib=$(( part_bytes / 1048576 ))
  id=$(od -An -tx1 -N12 -v /dev/urandom)
  id=${id//[!0-9a-f]/}
  qd=$(q "$dest")
  part=$(mktemp "${TMPDIR:-/tmp}/filebox.XXXXXX")
  # shellcheck disable=SC2064
  trap "rm -f '$part'" EXIT
  n=1
  while [ "$n" -le "$of" ]; do
    echo "第 $n/$of 段" >&2
    dd if="$src" of="$part" bs=1048576 skip=$(( (n - 1) * mib )) count="$mib" 2>/dev/null
    QUIET=$PROGRESS
    receipt=$(api_retry -T "$part" -H "Expect:" -H "Content-Type: application/octet-stream" \
      "$BASE/api/upload/part?format=text&path=$qd&id=$id&n=$n&of=$of&size=$size")
    receipts="$receipts$receipt$NL"
    n=$((n + 1))
  done
  rm -f "$part"
  QUIET=-s
  api -X POST -H "Content-Type: text/plain" -H "X-File-Type: $type" --data-binary "$receipts" \
    "$BASE/api/upload/complete?format=text&path=$qd$overwrite"
}

cmd="${1:-}"
if [ "$#" -gt 0 ]; then shift; fi

case "$cmd" in
  put)
    overwrite=""
    if [ "${1:-}" = "-f" ]; then overwrite="&overwrite=1"; shift; fi
    need "${1:-}" "put [-f] <本地文件> [远端路径]"
    src="$1"
    if [ ! -f "$src" ]; then
      echo "不是普通文件：$src" >&2
      exit 1
    fi
    dest="${2:-$(basename "$src")}"
    type=$(mime "$src")
    size=$(wc -c < "$src")
    size=${size//[!0-9]/}
    # 服务端返回「段长 单文件上限」两个数。
    limits=$(api "$BASE/api/upload/limits?format=text")
    part_bytes=${limits%% *}
    max_bytes=${limits##* }
    if [ "$size" -gt "$max_bytes" ]; then
      echo "文件有 $size 字节，超过单文件上限 $max_bytes 字节" >&2
      exit 1
    fi
    if [ "$size" -gt "$part_bytes" ]; then
      # 大文件要传很久，同名文件先查一下，免得传完才被拒绝。
      if [ -z "$overwrite" ] && api "$BASE/api/url?format=text&path=$(q "$dest")" >/dev/null 2>&1; then
        echo "同名文件已存在：${dest}（加 -f 覆盖）" >&2
        exit 1
      fi
      put_parts "$src" "$dest" "$size" "$part_bytes" "$type" "$overwrite"
      exit 0
    fi
    # -T 边读边传，不像 --data-binary 那样先把整个文件读进内存；方法是 PUT。
    # 清掉 Expect 头，省掉一次 100-continue 往返。
    QUIET=$PROGRESS
    api_retry -T "$src" -H "Expect:" -H "Content-Type: $type" \
      "$BASE/api/upload?format=text&path=$(q "$dest")$overwrite"
    ;;

  ls)
    recursive=""
    if [ "${1:-}" = "-r" ]; then recursive="&recursive=1"; shift; fi
    # q 遇到空串会输出一个孤立的 %，所以没给目录时不带 dir 参数。
    dir=""
    if [ -n "${1:-}" ]; then dir="&dir=$(q "$1")"; fi
    api "$BASE/api/files?format=text$dir$recursive"
    ;;

  whoami)
    if ! api "$BASE/api/whoami?format=text"; then
      echo "token 不能用。站点是 ${BASE}，检查 FILEBOX_TOKEN 和 FILEBOX_URL。" >&2
      exit 1
    fi
    ;;

  url)
    need "${1:-}" "url <远端路径>"
    api "$BASE/api/url?format=text&path=$(q "$1")"
    ;;

  mkdir)
    need "${1:-}" "mkdir <目录路径>"
    api -X POST "$BASE/api/folder?path=$(q "$1")" >/dev/null
    echo "已创建目录 $1"
    ;;

  rm)
    need "${1:-}" "rm <远端路径>"
    api -X DELETE "$BASE/api/file?path=$(q "$1")" >/dev/null
    echo "已删除 $1"
    ;;

  rmdir)
    need "${1:-}" "rmdir <目录路径>"
    api -X DELETE "$BASE/api/folder?path=$(q "$1")" >/dev/null
    echo "已删除目录 $1"
    ;;

  keep)
    need "${1:-}" "keep <远端路径>"
    api -X POST "$BASE/api/keep?format=text&path=$(q "$1")"
    ;;

  unkeep)
    need "${1:-}" "unkeep <远端路径>"
    api -X DELETE "$BASE/api/keep?format=text&path=$(q "$1")"
    ;;

  get)
    need "${1:-}" "get <远端路径> [保存为]"
    out="${2:-$(basename "$1")}"
    if [ -e "$out" ]; then
      echo "目标已存在：${out}（先移走或指定别的文件名）" >&2
      exit 1
    fi
    link=$(api "$BASE/api/url?format=text&path=$(q "$1")")
    curl "$PROGRESS" -S --fail --max-time 0 -A "$UA" -o "$out" "$link"
    echo "已保存到 $out"
    ;;

  version)
    echo "filebox ${VERSION}（${BASE}）"
    ;;

  update)
    if ! self=$(self_path); then
      echo "找不到脚本在磁盘上的位置（$0），请重新下载：curl -fsSL $BASE/filebox -o filebox" >&2
      exit 1
    fi
    dir=${self%/*}
    if [ ! -w "$dir" ]; then
      echo "没有权限写 ${dir}，用 sudo 运行，或者把脚本放到自己能写的目录" >&2
      exit 1
    fi
    # 先下载到同一目录下的临时文件，检查无误再用 mv 原子替换。不能直接覆盖：
    # bash 是边读边执行脚本的，原地改写正在运行的脚本会让它执行错乱。
    # cp -p 让临时文件带上原文件的权限位，curl -o 写进去时保留。
    tmp="$dir/.filebox.update.$$"
    # shellcheck disable=SC2064
    trap "rm -f '$tmp'" EXIT
    cp -p "$self" "$tmp"
    if ! curl -fsS --max-time 120 -A "$UA" -o "$tmp" "$BASE/filebox"; then
      echo "下载失败：$BASE/filebox" >&2
      exit 1
    fi
    new=$(sed -n 's/^VERSION="\(.*\)"$/\1/p' "$tmp")
    if [ "$(sed -n 1p "$tmp")" != "#!/usr/bin/env bash" ] || [ -z "$new" ] || ! "$BASH" -n "$tmp"; then
      echo "下载到的不像是 filebox 脚本，没有替换。" >&2
      exit 1
    fi
    if [ "$(<"$tmp")" = "$(<"$self")" ]; then
      echo "已经是最新版（${VERSION}）：$self"
      exit 0
    fi
    mv -f "$tmp" "$self"
    echo "已更新：$VERSION → ${new}（${self}）"
    exit 0
    ;;

  *)
    sed -n '2,/^set -euo/p' "$0" | sed -e '$d' -e 's/^# \{0,1\}//'
    exit 1
    ;;
esac
