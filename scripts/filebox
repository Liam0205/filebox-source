#!/usr/bin/env bash
# filebox 的命令行客户端。
#
#   export FILEBOX_TOKEN=fb_xxxx        # 在 /admin 里生成；也可以用 filebox login 存进配置文件
#   export FILEBOX_URL=https://…        # 从站点 /filebox 下载的脚本已带默认值
#   export FILEBOX_QUIET=1              # 可选，关掉 put/get 在终端里的进度条
#
#   filebox login                            # 把 token 存进 ~/.config/filebox/token，之后不用设 FILEBOX_TOKEN
#   filebox logout                           # 删掉存下的 token
#   filebox whoami                           # 检查 token 是否配置正确
#   filebox put ./photo.jpg                  # 上传到根目录，成功后打印下载地址
#   filebox put ./photo.jpg album/2026.jpg   # 上传到指定路径（同名默认拒绝）
#   filebox put -f ./photo.jpg album/2026.jpg  # 覆盖同名文件
#   filebox ls                               # 列出根目录下一层
#   filebox ls album                         # 列出 album 下一层
#   filebox ls -r [album]                    # 列出下面的全部文件
#   filebox get album/2026.jpg [保存为]
#   filebox url album/2026.jpg
#   filebox mkdir album/2026
#   filebox rm album/2026.jpg
#   filebox rmdir album/2026                 # 只删空目录
#   filebox keep album/2026.jpg              # 设为长期，不参与自动清理
#   filebox unkeep album/2026.jpg            # 取消长期
#   filebox update                           # 从站点下载新版，替换这个脚本
#   filebox version
#   filebox install-finder                   # macOS：在 Finder 右键菜单里加「上传到 filebox」
#   filebox uninstall-finder                 # macOS：去掉这个右键菜单
#
# 单文件上限 2 GiB。超过 95 MiB 的文件会自动分段上传，下载时站点自动拼回一个文件。
#
# 这是临时存储：超过个人名额、或者全站文件太多时，最旧的非长期文件会被自动删除。
# 大文件每 95 MiB 左右占一个名额。ls 第一行显示用量。
#
# 依赖 bash、curl、od、sed，分段上传还要 dd、wc、mktemp；有 file 命令时用它判断文件类型。
# login 要用 mkdir；Finder 右键菜单要用 macOS 自带的 osascript 和 pbcopy。
#
# 兼容性要求：要能在 macOS 自带的 Bash 3.2、BSD 工具和旧版 curl 上跑。
# 所以不用关联数组、mapfile、${var,,}、curl 的 --fail-with-body，
# 也不依赖 python3 或 jq：需要解析的响应都让服务端用 ?format=text 返回纯文本。
# 变量后面紧跟中文（包括全角标点）时必须写成 ${name}：macOS 的 Bash 3.2 在 UTF-8 下
# 会把中文的首字节当成变量名的一部分。比如变量 new 后面直接跟「（」而不加花括号，会被
# 读成变量 new\xef，在 set -u 下直接报错。
set -euo pipefail

# Worker 下发脚本时会把这两行替换成站点地址和版本号；仓库里的副本保持原样。
DEFAULT_URL=""
VERSION="dev"
# 所有请求都带这个 UA，方便在访问统计里把命令行和浏览器、裸 curl 分开，也能看出
# 还有哪些旧版本在跑。UA 可以伪造，服务端只能拿它做统计，不能据此放行或区别对待。
UA="filebox-cli/$VERSION"

BASE="${FILEBOX_URL:-$DEFAULT_URL}"
if [ -z "$BASE" ]; then
  echo "需要设置 FILEBOX_URL，例如 https://filebox.example.com" >&2
  exit 1
fi
BASE="${BASE%/}"
NL='
'

# token 先看环境变量，没有再读 filebox login 存下的文件。Finder 右键菜单这类
# 不读 shell 配置的场合拿不到环境变量，只能靠这个文件。
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/filebox"
TOKEN_FILE="$CONFIG_DIR/token"
TOKEN="${FILEBOX_TOKEN:-}"
if [ -z "$TOKEN" ] && [ -r "$TOKEN_FILE" ]; then
  TOKEN=$(sed -n -e 's/[[:space:]]//g' -e '1p' "$TOKEN_FILE")
fi

# 传输较大的 put 和 get 在 stderr 连着终端时显示 curl 的进度条（-#），
# stderr 被重定向时保持安静。
QUIET=-s
PROGRESS=-s
if [ -t 2 ] && [ -z "${FILEBOX_QUIET:-}" ]; then PROGRESS=-#; fi

need_token() {
  if [ -z "$TOKEN" ]; then
    echo "需要设置 FILEBOX_TOKEN，或者运行 filebox login 保存 token（在 $BASE/admin 里生成）" >&2
    exit 1
  fi
}

# 调接口。成功时把响应体写到 stdout；HTTP 状态不是 2xx 时把响应体写到 stderr，返回 1。
# 最近一次的 HTTP 状态码留在 API_CODE 里（网络错误时为空）。
API_CODE=""
api() {
  local out code
  need_token
  API_CODE=""
  if ! out=$(curl "$QUIET" -S --max-time 0 -A "$UA" -w "$NL%{http_code}" -H "Authorization: Bearer $TOKEN" "$@"); then
    return 1
  fi
  code=${out##*"$NL"}
  out=${out%"$NL"*}
  out=${out%"$NL"}
  API_CODE=$code
  case "$code" in
    2[0-9][0-9])
      printf '%s\n' "$out"
      ;;
    *)
      printf '%s\n' "$out" >&2
      return 1
      ;;
  esac
}

# 上传类请求遇到 507（release 满了，服务端已经清理了一批旧文件）时重传一次。
api_retry() {
  if api "$@"; then return 0; fi
  if [ "$API_CODE" != "507" ]; then return 1; fi
  echo "重新上传一次…" >&2
  api "$@"
}

# 百分号编码。每个字节都编码成 %xx，服务端照样能解开；
# 用 od 拿字节，避开 Bash 3.2 按 locale 切字符的问题。
q() {
  # shellcheck disable=SC2046
  printf '%%%s' $(printf '%s' "$1" | od -An -tx1 -v)
}

mime() {
  local t=""
  if command -v file >/dev/null 2>&1; then
    t=$(file --brief --mime-type "$1" 2>/dev/null || true)
  fi
  case "$t" in
    */*) printf '%s\n' "$t" ;;
    *) printf '%s\n' "application/octet-stream" ;;
  esac
}

need() {
  if [ -z "${1:-}" ]; then
    echo "用法: filebox $2" >&2
    exit 1
  fi
}

# 这个脚本在磁盘上的真实路径。从 PATH 里运行时 $0 是完整路径；
# 用 bash filebox 运行时 $0 是相对路径；中间如果有软链接，一层层解开。
# macOS 的 readlink 没有 -f，所以自己循环。
self_path() {
  local p="$0" link n=0
  case "$p" in
    */*) ;;
    *)
      if [ -f "$p" ]; then p="./$p"; else p=$(command -v "$p" 2>/dev/null || true); fi
      ;;
  esac
  if [ -z "$p" ] || [ ! -f "$p" ]; then return 1; fi
  while [ -h "$p" ] && [ "$n" -lt 40 ]; do
    link=$(readlink "$p")
    case "$link" in
      /*) p="$link" ;;
      *) p="${p%/*}/$link" ;;
    esac
    n=$((n + 1))
  done
  printf '%s/%s\n' "$(cd "${p%/*}" && pwd -P)" "${p##*/}"
}

# 把 token 写进配置文件。目录和文件都只有自己能读；先写临时文件再 mv，
# 写到一半中断也不会留下半个 token。
save_token() {
  local tmp="$TOKEN_FILE.$$"
  (umask 077 && mkdir -p "$CONFIG_DIR" && printf '%s\n' "$1" > "$tmp")
  mv -f "$tmp" "$TOKEN_FILE"
}

# macOS 的系统通知。标题和正文作为参数传给 AppleScript，不拼进脚本文本，
# 文件名里有引号也不会出问题。
notify() {
  osascript -e 'on run argv' -e 'display notification (item 2 of argv) with title (item 1 of argv)' \
    -e 'end run' "$1" "$2" >/dev/null 2>&1 || true
}

# Finder 右键菜单是 ~/Library/Services 下的一个 Automator 快速操作，里面只有一步
# 「运行 Shell 脚本」：把选中的文件作为参数交给 filebox finder-upload。
# 快速操作调用的是脚本的一份副本，不是脚本本身：脚本可能放在「文稿」「桌面」这类
# 受隐私保护的目录里（或者经软链接指到那里），快速操作的进程读不了，bash 会报
# Operation not permitted。filebox update 会顺带更新这份副本。
FINDER_WORKFLOW="$HOME/Library/Services/上传到 filebox.workflow"
FINDER_COPY="$HOME/Library/Application Support/filebox/filebox"

# 把脚本自己复制成右键菜单用的副本，先写临时文件再 mv。
sync_finder_copy() {
  local tmp="$FINDER_COPY.$$"
  mkdir -p "${FINDER_COPY%/*}"
  cp -p "$1" "$tmp"
  mv -f "$tmp" "$FINDER_COPY"
}

# 两个文件照着 macOS 15 的 Automator 保存出来的内容写。少了 Info.plist 里的
# NSIconName 和 document.wflow 里的 applicationPaths 等字段时，系统登记了服务，
# 菜单里却不出现。
install_finder() {
  local dir="$FINDER_WORKFLOW/Contents"
  rm -rf "$FINDER_WORKFLOW"
  mkdir -p "$dir"
  cat > "$dir/Info.plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSServices</key>
	<array>
		<dict>
			<key>NSBackgroundColorName</key>
			<string>background</string>
			<key>NSIconName</key>
			<string>NSTouchBarSend</string>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>上传到 filebox</string>
			</dict>
			<key>NSMessage</key>
			<string>runWorkflowAsService</string>
			<key>NSRequiredContext</key>
			<dict>
				<key>NSApplicationIdentifier</key>
				<string>com.apple.finder</string>
			</dict>
			<key>NSSendFileTypes</key>
			<array>
				<string>public.item</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
EOF
  cat > "$dir/document.wflow" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
