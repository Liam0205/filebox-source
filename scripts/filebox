# 分段上传：按服务端给的段长用 dd 切出临时文件，逐段上传换回执，最后交回全部回执。
# 一段失败就整个放弃：已经传上去的段没有索引，过几个小时会被自动清掉。
put_parts() {
  local src="$1" dest="$2" size="$3" part_bytes="$4" type="$5" overwrite="$6"
  local of mib id part n receipt receipts="" qd
  of=$(( (size + part_bytes - 1) / part_bytes ))
  mib=$(( part_bytes / 1048576 ))
  id=$(od -An -tx1 -N12 -v /dev/urandom)
  id=${id//[!0-9a-f]/}
  qd=$(q "$dest")
  part=$(mktemp "${TMPDIR:-/tmp}/filebox.XXXXXX")
  # shellcheck disable=SC2064
  trap "rm -f '$part'" EXIT
  n=1
  while [ "$n" -le "$of" ]; do
    echo "第 $n/$of 段" >&2
    # 从 Finder 右键菜单调用时没有终端，进度只能靠通知。
    if [ -n "${FILEBOX_NOTIFY:-}" ]; then notify "filebox 上传中" "${dest##*/}：第 $n/$of 段"; fi
    dd if="$src" of="$part" bs=1048576 skip=$(( (n - 1) * mib )) count="$mib" 2>/dev/null
    QUIET=$PROGRESS
    receipt=$(api_retry -T "$part" -H "Expect:" -H "Content-Type: application/octet-stream" \
      "$BASE/api/upload/part?format=text&path=$qd&id=$id&n=$n&of=$of&size=$size")
    receipts="$receipts$receipt$NL"
    n=$((n + 1))
  done
  rm -f "$part"
  QUIET=-s
  api -X POST -H "Content-Type: text/plain" -H "X-File-Type: $type" --data-binary "$receipts" \
    "$BASE/api/upload/complete?format=text&path=$qd$overwrite"
}

cmd="${1:-}"
if [ "$#" -gt 0 ]; then shift; fi

case "$cmd" in
  put)
    overwrite=""
    if [ "${1:-}" = "-f" ]; then overwrite="&overwrite=1"; shift; fi
    need "${1:-}" "put [-f] <本地文件> [远端路径]"
    src="$1"
    if [ ! -f "$src" ]; then
      echo "不是普通文件：$src" >&2
      exit 1
    fi
    dest="${2:-$(basename "$src")}"
    type=$(mime "$src")
    size=$(wc -c < "$src")
    size=${size//[!0-9]/}
    # 服务端返回「段长 单文件上限」两个数。
    limits=$(api "$BASE/api/upload/limits?format=text")
    part_bytes=${limits%% *}
    max_bytes=${limits##* }
    if [ "$size" -gt "$max_bytes" ]; then
      echo "文件有 $size 字节，超过单文件上限 $max_bytes 字节" >&2
      exit 1
    fi
    if [ "$size" -gt "$part_bytes" ]; then
      # 大文件要传很久，同名文件先查一下，免得传完才被拒绝。
      if [ -z "$overwrite" ] && api "$BASE/api/url?format=text&path=$(q "$dest")" >/dev/null 2>&1; then
        echo "同名文件已存在：${dest}（加 -f 覆盖）" >&2
        exit 1
      fi
      put_parts "$src" "$dest" "$size" "$part_bytes" "$type" "$overwrite"
      exit 0
    fi
    # -T 边读边传，不像 --data-binary 那样先把整个文件读进内存；方法是 PUT。
    # 清掉 Expect 头，省掉一次 100-continue 往返。
    QUIET=$PROGRESS
    api_retry -T "$src" -H "Expect:" -H "Content-Type: $type" \
      "$BASE/api/upload?format=text&path=$(q "$dest")$overwrite"
    ;;

  ls)
    recursive=""
    if [ "${1:-}" = "-r" ]; then recursive="&recursive=1"; shift; fi
    # q 遇到空串会输出一个孤立的 %，所以没给目录时不带 dir 参数。
    dir=""
    if [ -n "${1:-}" ]; then dir="&dir=$(q "$1")"; fi
    api "$BASE/api/files?format=text$dir$recursive"
    ;;

  login)
    # token 从标准输入读，不放在命令行参数里，免得进 shell 历史。
    # 终端里交互输入时不回显；也可以用管道传进来，比如 pbpaste | filebox login。
    TOKEN=""
    if [ -t 0 ]; then
      printf '粘贴 token（在 %s/admin 里生成，输入时不显示）：' "$BASE" >&2
      read -r -s TOKEN || true
      echo >&2
    else
      read -r TOKEN || true
    fi
    TOKEN=$(printf '%s' "$TOKEN" | sed 's/[[:space:]]//g')
    if [ -z "$TOKEN" ]; then
      echo "没有读到 token" >&2
      exit 1
    fi
    if ! who=$(api "$BASE/api/whoami?format=text"); then
      echo "token 不能用（站点是 ${BASE}），没有保存。" >&2
      exit 1
    fi
    save_token "$TOKEN"
    echo "已保存到 ${TOKEN_FILE}：$who"
    ;;

  logout)
    rm -f "$TOKEN_FILE"
    echo "已删除 $TOKEN_FILE"
    ;;

  whoami)
    if ! api "$BASE/api/whoami?format=text"; then
      echo "token 不能用。站点是 ${BASE}，检查 FILEBOX_TOKEN 和 FILEBOX_URL。" >&2
      exit 1
    fi
    ;;

  url)
    need "${1:-}" "url <远端路径>"
    api "$BASE/api/url?format=text&path=$(q "$1")"
    ;;

  mkdir)
    need "${1:-}" "mkdir <目录路径>"
    api -X POST "$BASE/api/folder?path=$(q "$1")" >/dev/null
    echo "已创建目录 $1"
    ;;

  rm)
    need "${1:-}" "rm <远端路径>"
    api -X DELETE "$BASE/api/file?path=$(q "$1")" >/dev/null
    echo "已删除 $1"
    ;;

  rmdir)
    need "${1:-}" "rmdir <目录路径>"
    api -X DELETE "$BASE/api/folder?path=$(q "$1")" >/dev/null
    echo "已删除目录 $1"
    ;;

  keep)
    need "${1:-}" "keep <远端路径>"
    api -X POST "$BASE/api/keep?format=text&path=$(q "$1")"
    ;;

  unkeep)
    need "${1:-}" "unkeep <远端路径>"
    api -X DELETE "$BASE/api/keep?format=text&path=$(q "$1")"
    ;;

  get)
    need "${1:-}" "get <远端路径> [保存为]"
    out="${2:-$(basename "$1")}"
    if [ -e "$out" ]; then
      echo "目标已存在：${out}（先移走或指定别的文件名）" >&2
      exit 1
    fi
    link=$(api "$BASE/api/url?format=text&path=$(q "$1")")
    curl "$PROGRESS" -S --fail --max-time 0 -A "$UA" -o "$out" "$link"
    echo "已保存到 $out"
    ;;

  version)
    echo "filebox ${VERSION}（${BASE}）"
    ;;

  update)
    if ! self=$(self_path); then
      echo "找不到脚本在磁盘上的位置（$0），请重新下载：curl -fsSL $BASE/filebox -o filebox" >&2
      exit 1
    fi
    dir=${self%/*}
    if [ ! -w "$dir" ]; then
      echo "没有权限写 ${dir}，用 sudo 运行，或者把脚本放到自己能写的目录" >&2
      exit 1
    fi
    # 先下载到同一目录下的临时文件，检查无误再用 mv 原子替换。不能直接覆盖：
    # bash 是边读边执行脚本的，原地改写正在运行的脚本会让它执行错乱。
    # cp -p 让临时文件带上原文件的权限位，curl -o 写进去时保留。
    tmp="$dir/.filebox.update.$$"
    # shellcheck disable=SC2064
    trap "rm -f '$tmp'" EXIT
    cp -p "$self" "$tmp"
    if ! curl -fsS --max-time 120 -A "$UA" -o "$tmp" "$BASE/filebox"; then
      echo "下载失败：$BASE/filebox" >&2
      exit 1
    fi
    new=$(sed -n 's/^VERSION="\(.*\)"$/\1/p' "$tmp")
    if [ "$(sed -n 1p "$tmp")" != "#!/usr/bin/env bash" ] || [ -z "$new" ] || ! "$BASH" -n "$tmp"; then
      echo "下载到的不像是 filebox 脚本，没有替换。" >&2
      exit 1
    fi
    if [ "$(<"$tmp")" = "$(<"$self")" ]; then
      echo "已经是最新版（${VERSION}）：$self"
    else
      mv -f "$tmp" "$self"
      echo "已更新：$VERSION → ${new}（${self}）"
    fi
    # 装过右键菜单的话，它用的副本也跟着更新。
    if [ -f "$FINDER_COPY" ] && [ "$self" != "$FINDER_COPY" ]; then
      sync_finder_copy "$self"
    fi
    exit 0
    ;;

  install-finder)
    if ! command -v osascript >/dev/null 2>&1 || [ ! -d "$HOME/Library" ]; then
      echo "Finder 右键菜单只能装在 macOS 上" >&2
      exit 1
    fi
    if ! self=$(self_path); then
      echo "找不到脚本在磁盘上的位置（$0），没法安装右键菜单" >&2
      exit 1
    fi
    # 副本路径和站点地址会原样写进快速操作的 shell 命令和 plist，含引号、反斜杠、
    # $、反引号或 XML 特殊字符时不处理，免得转义出错。
    case "$FINDER_COPY$BASE" in
      *[\'\"\\\$\`\&\<\>]*)
        echo "用户目录或站点地址里有特殊字符，没法生成右键菜单：$FINDER_COPY $BASE" >&2
        exit 1
        ;;
    esac
    # 右键菜单运行时读不到 shell 里的环境变量，token 必须在配置文件里。
    if [ ! -s "$TOKEN_FILE" ]; then
      if [ -z "${FILEBOX_TOKEN:-}" ]; then
        echo "先运行 filebox login 保存 token，再安装右键菜单" >&2
        exit 1
      fi
      if ! api "$BASE/api/whoami?format=text" >/dev/null; then
        echo "FILEBOX_TOKEN 不能用（站点是 ${BASE}），没有安装。" >&2
        exit 1
      fi
      save_token "$FILEBOX_TOKEN"
      echo "已把 FILEBOX_TOKEN 保存到 $TOKEN_FILE"
    fi
    if [ "$self" != "$FINDER_COPY" ]; then sync_finder_copy "$self"; fi
    install_finder
    echo "已安装：在 Finder 里选中文件，右键 → 快速操作 → 上传到 filebox，链接会复制到剪贴板。"
    echo "右键菜单用的是脚本的副本：$FINDER_COPY"
    echo "filebox update 会顺带更新它；脚本挪了位置也不用重装。"
    ;;

  uninstall-finder)
    rm -rf "$FINDER_WORKFLOW"
    rm -f "$FINDER_COPY"
    rmdir "${FINDER_COPY%/*}" 2>/dev/null || true
    echo "已删除 $FINDER_WORKFLOW 和 $FINDER_COPY"
    ;;

  finder-upload)
    # install-finder 装的快速操作调用它：逐个上传选中的文件，到根目录，同名不覆盖；
    # 链接放进剪贴板，结果用系统通知告诉用户。运行时没有终端，出错也只能靠通知，
    # 所以总是返回 0，免得 Automator 再弹一个看不懂的错误框。
    # 开始时先发一条通知，大文件每段再发一条（put_parts 看 FILEBOX_NOTIFY），
    # 不然传大文件时几分钟没有任何动静，看不出是不是还在传。
    links=""
    n=0
    failed=0
    first_err=""
    total=0
    if [ "$#" -eq 0 ]; then exit 0; fi
    for f in "$@"; do
      if [ -f "$f" ]; then
        s=$(wc -c < "$f")
        total=$((total + ${s//[!0-9]/}))
      fi
    done
    if [ "$total" -ge 1048576 ]; then human="$((total / 1048576)) MiB"; else human="$(( (total + 1023) / 1024 )) KiB"; fi
    if [ "$#" -eq 1 ]; then
      notify "filebox 上传中" "开始上传 $(basename "$1")（${human}），传完会再通知"
    else
      notify "filebox 上传中" "开始上传 $# 个文件（共 ${human}），传完会再通知"
    fi
    err=$(mktemp)
    for f in "$@"; do
      name=$(basename "$f")
      if [ ! -f "$f" ]; then
        msg="不是普通文件（目录要先打包）"
      elif link=$(FILEBOX_NOTIFY=1 "$BASH" "$0" put "$f" 2>"$err"); then
        links="$links${link##*"$NL"}$NL"
        n=$((n + 1))
        continue
      else
        # 接口出错时 stderr 是 {"error": "…"}；网络错误时是 curl 的报错，取最后一行。
        msg=$(sed -n 's/.*"error": *"\(.*\)".*/\1/p' "$err" | sed -n 1p)
        if [ -z "$msg" ]; then msg=$(sed -n '$p' "$err"); fi
      fi
      failed=$((failed + 1))
      if [ -z "$first_err" ]; then first_err="${name}：${msg}"; fi
    done
    rm -f "$err"
    if [ "$n" -gt 0 ]; then printf '%s' "$links" | pbcopy; fi
    if [ "$failed" -eq 0 ]; then
      if [ "$n" -eq 1 ]; then
        notify "filebox" "已上传 ${name}，链接已复制到剪贴板"
      elif [ "$n" -gt 1 ]; then
        notify "filebox" "已上传 $n 个文件，链接已复制到剪贴板"
      fi
    elif [ "$n" -eq 0 ]; then
      notify "filebox 上传失败" "$first_err"
    else
      notify "filebox" "上传了 $n 个，失败 $failed 个。${first_err}"
    fi
    exit 0
    ;;

  *)
    sed -n '2,/^set -euo/p' "$0" | sed -e '$d' -e 's/^# \{0,1\}//'
    exit 1
    ;;
esac
