{
  "__inputs": [
    {
      "name": "DS_AE",
      "label": "Analytics Engine",
      "description": "指向 Analytics Engine SQL API 的 Altinity ClickHouse 数据源",
      "type": "datasource",
      "pluginId": "vertamedia-clickhouse-datasource",
      "pluginName": "Altinity plugin for ClickHouse"
    }
  ],
  "__requires": [
    {
      "type": "datasource",
      "id": "vertamedia-clickhouse-datasource",
      "name": "Altinity plugin for ClickHouse",
      "version": "3.0.0"
    }
  ],
  "uid": "filebox",
  "title": "filebox",
  "tags": [
    "cloudflare",
    "filebox"
  ],
  "description": "filebox 的上传、下载次数和速度。数据来自 Workers Analytics Engine 的 filebox_xfer，列的含义见仓库 llmdoc/architecture/storage-and-auth.md 的「长期统计」。",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "timezone": "browser",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "30m",
  "timepicker": {
    "refresh_intervals": [
      "15m",
      "30m",
      "1h"
    ]
  },
  "templating": {
    "list": [
      {
        "name": "min_mb",
        "label": "速度只看不小于（MB）",
        "type": "textbox",
        "query": "20",
        "current": {
          "text": "20",
          "value": "20"
        },
        "options": [
          {
            "selected": true,
            "text": "20",
            "value": "20"
          }
        ]
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "概览",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "传输次数",
      "datasource": {
        "type": "vertamedia-clickhouse-datasource",
        "uid": "${DS_AE}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 9,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "vertamedia-clickhouse-datasource",
            "uid": "${DS_AE}"
          },
          "format": "time_series",
          "query": "SELECT $timeSeries AS t, format('{}{}', if(blob1 = 'up', '上传', '下载'), if(double5 = 1, '', '（中断）')) AS dir, sum(_sample_interval) AS transfers FROM filebox_xfer WHERE $timeFilter GROUP BY t, dir ORDER BY t",
          "editorMode": "sql",
          "database": "default",
          "table": "filebox_xfer",
          "dateTimeType": "DATETIME",
          "dateTimeColDataType": "timestamp",
          "dateColDataType": "",
          "interval": "",
          "intervalFactor": 1,
          "round": "0s",
          "extrapolate": false,
          "add_metadata": false,
          "skip_comments": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "stacking": {
              "mode": "normal"
            }
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "interval": "10m",
      "description": "每个请求算一次：分段上传每段一次，带 Range 的下载每个请求一次。中断：客户端取消、断线，或者上游出错。"
    },
    {
      "id": 3,
      "type": "stat",
      "title": "合计",
      "datasource": {
        "type": "vertamedia-clickhouse-datasource",
        "uid": "${DS_AE}"
      },
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "vertamedia-clickhouse-datasource",
            "uid": "${DS_AE}"
          },
          "format": "table",
          "query": "SELECT sumIf(_sample_interval, blob1 = 'up' AND double5 = 1) AS uploads, sumIf(_sample_interval, blob1 = 'down' AND double5 = 1) AS downloads, sumIf(double1 * _sample_interval, blob1 = 'up' AND double5 = 1) AS up_bytes, sumIf(double1 * _sample_interval, blob1 = 'down' AND double5 = 1) AS down_bytes, sumIf(_sample_interval, double5 = 0) AS failed FROM filebox_xfer WHERE $timeFilter",
          "editorMode": "sql",
          "database": "default",
          "table": "filebox_xfer",
          "dateTimeType": "DATETIME",
          "dateTimeColDataType": "timestamp",
          "dateColDataType": "",
          "interval": "",
          "intervalFactor": 1,
          "round": "0s",
          "extrapolate": false,
          "add_metadata": false,
          "skip_comments": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "uploads"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "上传"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "downloads"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "下载"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "up_bytes"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "上传字节"
              },
              {
                "id": "unit",
                "value": "decbytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "down_bytes"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "下载字节"
              },
              {
                "id": "unit",
                "value": "decbytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "failed"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "中断"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/"
        },
        "colorMode": "none",
        "graphMode": "none"
      },
      "description": "上传、下载只数传完的，字节也只算传完的。"
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "传输的字节",
      "datasource": {
        "type": "vertamedia-clickhouse-datasource",
        "uid": "${DS_AE}"
      },
      "gridPos": {
        "x": 9,
        "y": 1,
        "w": 9,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "vertamedia-clickhouse-datasource",
            "uid": "${DS_AE}"
          },
          "format": "time_series",
          "query": "SELECT $timeSeries AS t, if(blob1 = 'up', '上传', '下载') AS dir, sum(double1 * _sample_interval) AS bytes FROM filebox_xfer WHERE $timeFilter AND double5 = 1 GROUP BY t, dir ORDER BY t",
          "editorMode": "sql",
          "database": "default",
          "table": "filebox_xfer",
          "dateTimeType": "DATETIME",
          "dateTimeColDataType": "timestamp",
          "dateColDataType": "",
          "interval": "",
          "intervalFactor": 1,
          "round": "0s",
          "extrapolate": false,
          "add_metadata": false,
          "skip_comments": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "stacking": {
              "mode": "normal"
            }
          },
          "unit": "decbytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "interval": "10m",
      "description": "只算传完的传输。"
    },
    {
      "id": 5,
      "type": "table",
      "title": "各用户",
      "datasource": {
        "type": "vertamedia-clickhouse-datasource",
        "uid": "${DS_AE}"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "vertamedia-clickhouse-datasource",
            "uid": "${DS_AE}"
          },
          "format": "table",
          "query": "SELECT blob2 AS user, sumIf(_sample_interval, blob1 = 'up' AND double5 = 1) AS uploads, sumIf(_sample_interval, blob1 = 'down' AND double5 = 1) AS downloads, sumIf(double1 * _sample_interval, blob1 = 'up' AND double5 = 1) AS up_bytes, sumIf(double1 * _sample_interval, blob1 = 'down' AND double5 = 1) AS down_bytes, sumIf(_sample_interval, double5 = 0) AS failed FROM filebox_xfer WHERE $timeFilter GROUP BY user ORDER BY down_bytes DESC",
          "editorMode": "sql",
          "database": "default",
          "table": "filebox_xfer",
          "dateTimeType": "DATETIME",
          "dateTimeColDataType": "timestamp",
          "dateColDataType": "",
          "interval": "",
          "intervalFactor": 1,
          "round": "0s",
          "extrapolate": false,
          "add_metadata": false,
          "skip_comments": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "user"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "用户"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "uploads"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "上传"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "downloads"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "下载"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "up_bytes"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "上传字节"
              },
              {
                "id": "unit",
                "value": "decbytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "down_bytes"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "下载字节"
              },
              {
                "id": "unit",
                "value": "decbytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "failed"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "中断"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {},
      "description": "用户是文件的主人。下载不用登录，下载记在文件主人名下，不是下载的人。"
    },
    {
      "id": 6,
      "type": "row",
      "title": "速度",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "传输的平均速度（每 15 分钟）",
      "datasource": {
        "type": "vertamedia-clickhouse-datasource",
        "uid": "${DS_AE}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "vertamedia-clickhouse-datasource",
            "uid": "${DS_AE}"
          },
          "format": "time_series",
          "query": "SELECT (intDiv(toUInt32(timestamp), 900) * 900) * 1000 AS t, if(blob1 = 'up', '上传', '下载') AS dir, sum(double4 * _sample_interval) / sum(_sample_interval) AS speed FROM filebox_xfer WHERE $timeFilter AND double5 = 1 AND double1 >= $min_mb * 1000000 GROUP BY t, dir ORDER BY t",
          "editorMode": "sql",
          "database": "default",
          "table": "filebox_xfer",
          "dateTimeType": "DATETIME",
          "dateTimeColDataType": "timestamp",
          "dateColDataType": "",
          "interval": "",
          "intervalFactor": 1,
          "round": "0s",
          "extrapolate": false,
          "add_metadata": false,
          "skip_comments": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "MBs",
          "custom": {
            "drawStyle": "line",
            "showPoints": "always",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "每 15 分钟一个点：这 15 分钟里各次传输的速度的平均值，不随所选的时间范围变。没有合格传输的时间段没有点。只算传完、且不小于 $min_mb MB 的传输。上传的耗时和客户端看到的一致；下载的耗时到字节交给 Cloudflare 运行时为止，之后还有 2–4 MB 的缓冲，所以小文件算出来偏快，缓存命中的小文件尤其明显。"
    },
    {
      "id": 8,
      "type": "table",
      "title": "各方向的速度",
      "datasource": {
        "type": "vertamedia-clickhouse-datasource",
        "uid": "${DS_AE}"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "vertamedia-clickhouse-datasource",
            "uid": "${DS_AE}"
          },
          "format": "table",
          "query": "SELECT if(blob1 = 'up', '上传', '下载') AS dir, blob4 AS cache, sum(_sample_interval) AS transfers, sum(double1 * _sample_interval) AS bytes, quantileExactWeighted(0.1)(double4, _sample_interval) AS p10, quantileExactWeighted(0.5)(double4, _sample_interval) AS p50, quantileExactWeighted(0.9)(double4, _sample_interval) AS p90, sum(double1 * _sample_interval) / 1000 / sum((double2 - double3) * _sample_interval) AS overall, sum(double3 * _sample_interval) / sum(_sample_interval) AS wait_ms FROM filebox_xfer WHERE $timeFilter AND double5 = 1 AND double1 >= $min_mb * 1000000 GROUP BY dir, cache ORDER BY transfers DESC",
          "editorMode": "sql",
          "database": "default",
          "table": "filebox_xfer",
          "dateTimeType": "DATETIME",
          "dateTimeColDataType": "timestamp",
          "dateColDataType": "",
          "interval": "",
          "intervalFactor": 1,
          "round": "0s",
          "extrapolate": false,
          "add_metadata": false,
          "skip_comments": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "dir"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "方向"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "cache"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "缓存"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "transfers"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "次数"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "bytes"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "字节"
              },
              {
                "id": "unit",
                "value": "decbytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p10"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "p10"
              },
              {
                "id": "unit",
                "value": "MBs"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p50"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "p50"
              },
              {
                "id": "unit",
                "value": "MBs"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p90"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "p90"
              },
              {
                "id": "unit",
                "value": "MBs"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "overall"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "总字节 / 总耗时"
              },
              {
                "id": "unit",
                "value": "MBs"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "wait_ms"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "等待"
              },
              {
                "id": "unit",
                "value": "ms"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {},
      "description": "缓存：HIT 是边缘缓存命中，不经过 GitHub；MISS 和 BYPASS 从 GitHub 取（分段的大文件都是 BYPASS）；上传没有这一项。等待：开始送出字节之前花的时间，速度里已经扣掉。只算传完、且不小于 $min_mb MB 的传输。上传的耗时和客户端看到的一致；下载的耗时到字节交给 Cloudflare 运行时为止，之后还有 2–4 MB 的缓冲，所以小文件算出来偏快，缓存命中的小文件尤其明显。"
    },
